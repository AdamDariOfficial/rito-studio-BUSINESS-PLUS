{
  "$schema": "schemas/tretnix-project.schema.json",
  "schema_version": 1,
  "project": {
    "id": "rito-studio-business-plus",
    "family": "beauty-wellness",
    "plan": "BUSINESS PLUS",
    "repository": "AdamDariOfficial/rito-studio-BUSINESS-PLUS",
    "default_branch": "main",
    "allowed_branch_prefixes": [
      "feature/",
      "fix/",
      "audit/",
      "refactor/",
      "docs/",
      "chore/",
      "codex/"
    ]
  },
  "sources": {
    "agents": [
      "AGENTS.md"
    ],
    "status": [],
    "local_decisions": [
      "docs/DECISIONS.md"
    ],
    "knowledge_tags": [
      "core",
      "frontend",
      "workflow",
      "security",
      "tooling",
      "release"
    ]
  },
  "context": {
    "compact_adapters": [
      {
        "base": "repo",
        "path": "docs/STATUS.md",
        "sections": [
          "## Current authoritative Final Freeze state — 10 September 2026"
        ],
        "reason": "Historical Final Freeze constraints only; current baseline must come from Git."
      }
    ],
    "source_allowlists": {
      "repo": [
        "AGENTS.md",
        "README.md",
        "docs/**",
        "compiled/**",
        "prompts/**",
        "src/**",
        "tools/**",
        "migrations/**",
        "package.json",
        "bun.lock",
        "bunfig.toml",
        "tsconfig.json",
        "eslint.config.js",
        "vite.config.ts",
        "wrangler.jsonc",
        "exports.cloudflare.ts",
        "components.json",
        "tretnix.project.json"
      ],
      "knowledge": [
        "DEVELOPMENT_STANDARDS.md",
        "DECISIONS.md",
        "BEAUTY_WELLNESS_FAMILY.md",
        "DEVELOPMENT_OS.md",
        "tools/tretnix/README.md",
        "skills/TASK_ADMISSION.md",
        "skills/SECURITY_RETEST.md",
        "skills/RELEASE_FREEZE.md",
        "skills/CONTROLLED_CHANGE_PACKAGE.md"
      ]
    },
    "tag_sources": {
      "core": [
        {
          "base": "knowledge",
          "path": "DEVELOPMENT_STANDARDS.md",
          "sections": [
            "## 1. Principi generali",
            "## 2. Analisi prima dell’implementazione",
            "## 3. Git e GitHub"
          ],
          "reason": "Shared development constraints and branch conventions."
        }
      ],
      "frontend": [
        {
          "base": "knowledge",
          "path": "DEVELOPMENT_STANDARDS.md",
          "sections": [
            "## 8. Responsive",
            "## 9. Routing, navigazione e scroll",
            "## 10. Animazioni",
            "## 11. Accessibilità"
          ],
          "reason": "Responsive, navigation, motion and accessibility parity contract."
        },
        {
          "base": "knowledge",
          "path": "BEAUTY_WELLNESS_FAMILY.md",
          "sections": [
            "## 4. Identità approvata",
            "## 7. Motion",
            "## 8. Integrità dei contenuti"
          ],
          "reason": "Family identity and honest demo content."
        },
        {
          "base": "repo",
          "path": "docs/ROUTES.md",
          "reason": "Existing PLUS route and navigation specification."
        },
        {
          "base": "repo",
          "path": "docs/PRODUCT.md",
          "reason": "Existing product definition; PLUS decisions supersede historical base scope."
        }
      ],
      "workflow": [
        {
          "base": "knowledge",
          "path": "DECISIONS.md",
          "sections": [
            "## TRX-DEC-041 — Toolchain operativo ChatGPT + Codex e Development OS v1"
          ],
          "reason": "Approved Development OS decision."
        },
        {
          "base": "knowledge",
          "path": "skills/TASK_ADMISSION.md",
          "reason": "Task admission and write boundaries."
        },
        {
          "base": "knowledge",
          "path": "skills/CONTROLLED_CHANGE_PACKAGE.md",
          "reason": "Controlled application and separate human gates."
        }
      ],
      "security": [
        {
          "base": "knowledge",
          "path": "DEVELOPMENT_STANDARDS.md",
          "sections": [
            "## 14. Sicurezza generale"
          ],
          "reason": "Shared security constraints."
        },
        {
          "base": "knowledge",
          "path": "skills/SECURITY_RETEST.md",
          "reason": "Delta-based local retest and separate live evidence."
        }
      ],
      "tooling": [
        {
          "base": "knowledge",
          "path": "DEVELOPMENT_OS.md",
          "sections": [
            "## 4. Context resolution e context cache",
            "## 5. Repository fingerprint",
            "## 6. Delta-first validation e validation cache",
            "## 8. Confini di automazione"
          ],
          "reason": "Exact-state context, fingerprint, cache and command restrictions."
        },
        {
          "base": "knowledge",
          "path": "tools/tretnix/README.md",
          "reason": "Canonical CLI invocation and exit-code contract."
        }
      ],
      "release": [
        {
          "base": "knowledge",
          "path": "skills/RELEASE_FREEZE.md",
          "reason": "Distinct candidate, review, Git, deployment and freeze gates."
        }
      ]
    }
  },
  "commands": {
    "install": null,
    "typecheck": "bun run typecheck",
    "lint": "bun run lint",
    "test": "bun run test",
    "security": "bun run test:security",
    "build": "bun run build"
