# RITO Studio BUSINESS PLUS
# Public/browser-safe feature switches.
VITE_CONSULTATION_PROFILE=demo
VITE_CONSULTATION_HANDOFF=inbox
VITE_CONSULTATION_WHATSAPP_URL=
VITE_CONSULTATION_EXTERNAL_URL=

# Live backend note
# D1, Durable Objects and Workers Rate Limiting are Worker bindings/configuration,
# not browser .env values. Native RITO AdminAuth also requires the Worker secrets
# ADMIN_AUTH_PEPPER and ADMIN_AUTH_CSRF_SECRET. Never place those secrets, D1 IDs,
# password material or session tokens in VITE_* variables or committed files.
# Cloudflare Access is not the RITO admin identity/login boundary.
